[Unit]
Description=Medical Droid Core FastAPI Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/plastic-nurse/core
Environment="DROID_HAL=real"
Environment="PATH=/home/pi/plastic-nurse/core/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/home/pi/plastic-nurse/core/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
