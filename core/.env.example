DROID_HAL=mock
DROID_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
# Set to seed the initial admin user on first boot. Leave unset outside
# development to skip auto-seeding — create the admin manually instead.
# INITIAL_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./droid.db
MOTOR_WATCHDOG_TIMEOUT_SEC=1.5
CAMERA_FPS=15
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
